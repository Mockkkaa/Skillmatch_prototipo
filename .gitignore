# ============================================================
# SKILLMATCH - .gitignore
# ============================================================

# Dependencias (NUNCA subir al repo - muy pesadas y regenerables)
node_modules/
**/node_modules/

# Variables de entorno (contienen contraseñas/secretos)
.env
**/.env
!**/.env.example

# Archivos de entorno específicos del backend
backend/.env
backend/.env.local
backend/.env.production

# Build / Distribución
dist/
dist-ssr/
build/
frontend/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Archivos locales del editor
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# Uploads locales (archivos subidos por usuarios)
backend/uploads/*
!backend/uploads/.gitkeep

# Cache
.cache/
*.local

# Dumps de base de datos locales (nunca subir)
database/*.dump
database/*.bak
*.sql.gz
