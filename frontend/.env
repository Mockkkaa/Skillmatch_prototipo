# ============================================================
# SkillMatch Frontend - Variables de Entorno
# ============================================================
# IMPORTANTE: En desarrollo, usamos una ruta RELATIVA (/api)
# para que el proxy de Vite maneje el reenvío al backend.
# En producción, cambia esto a la URL absoluta de tu API.

# Desarrollo (proxy de Vite → http://localhost:3001/api)
VITE_API_URL=/api

# Producción (descomenta y ajusta cuando hagas deploy)
# VITE_API_URL=https://tu-dominio.com/api
